@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://ejemplo.org/superheroes/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alienigena a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Alienígena" ;
    dcterms:description "Personaje no humano proveniente del espacio exterior o reinos extra-dimensionales." ;
    rdfs:subClassOf ex:Alienigena,
        ex:Personaje,
        rdfs:Resource .

ex:Equipamiento a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Equipamiento" ;
    dcterms:description "Artefacto, arma o tecnología empleada." ;
    rdfs:subClassOf ex:Equipamiento,
        rdfs:Resource .

ex:HeroeDC a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Héroe de DC" ;
    dcterms:description "Superhéroe de la editorial DC Comics." ;
    rdfs:subClassOf ex:HeroeDC,
        ex:Personaje,
        ex:Superheroe,
        rdfs:Resource .

ex:HeroeMarvel a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Héroe de Marvel" ;
    dcterms:description "Superhéroe de la editorial Marvel Comics." ;
    rdfs:subClassOf ex:HeroeMarvel,
        ex:Personaje,
        ex:Superheroe,
        rdfs:Resource .

ex:Humano a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Humano" ;
    dcterms:description "Personaje de origen biológico terrestre." ;
    rdfs:subClassOf ex:Humano,
        ex:Personaje,
        rdfs:Resource .

ex:HumanoMutado a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Humano Mutado" ;
    dcterms:description "Humano con alteración biológica o genética." ;
    rdfs:subClassOf ex:Humano,
        ex:HumanoMutado,
        ex:Personaje,
        rdfs:Resource .

ex:HumanoTecnologico a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Humano Tecnológico" ;
    dcterms:description "Humano que utiliza gadgets o tecnología sin poderes nativos." ;
    rdfs:subClassOf ex:Humano,
        ex:HumanoTecnologico,
        ex:Personaje,
        rdfs:Resource .

ex:Personaje a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Personaje" ;
    dcterms:description "Clase raíz para entidades del universo de cómics." ;
    rdfs:subClassOf ex:Personaje,
        rdfs:Resource .

ex:Superheroe a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Superhéroe" ;
    dcterms:description "Personaje enfocado en proteger la humanidad." ;
    rdfs:subClassOf ex:Personaje,
        ex:Superheroe,
        rdfs:Resource .

ex:Superpoder a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Superpoder" ;
    dcterms:description "Habilidad sobrehumana o metahumana." ;
    rdfs:subClassOf ex:Superpoder,
        rdfs:Resource .

ex:Supervillano a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Supervillano" ;
    dcterms:description "Personaje antagonista que genera caos." ;
    rdfs:subClassOf ex:Personaje,
        ex:Supervillano,
        rdfs:Resource .

ex:VillanoDC a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Villano de DC" ;
    dcterms:description "Supervillano de la editorial DC Comics." ;
    rdfs:subClassOf ex:Personaje,
        ex:Supervillano,
        ex:VillanoDC,
        rdfs:Resource .

ex:VillanoMarvel a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Villano de Marvel" ;
    dcterms:description "Supervillano de la editorial Marvel Comics." ;
    rdfs:subClassOf ex:Personaje,
        ex:Supervillano,
        ex:VillanoMarvel,
        rdfs:Resource .

ex:Aquaman a ex:HeroeDC,
        ex:Humano,
        ex:HumanoMutado,
        ex:Personaje,
        ex:Superheroe,
        rdfs:Resource ;
    ex:poseeArmaMitica ex:TridenteDeNeptuno ;
    ex:poseeArtefacto ex:TridenteDeNeptuno ;
    ex:tienePoder ex:ComunicacionMarina ;
    ex:usaIdentidadOculta false ;
    ex:valorAmenaza 6 ;
    ex:valorPoder 65 ;
    ex:valorPopularidad 50 ;
    foaf:name "Arthur Curry"^^xsd:string .

ex:CapitanAmerica a ex:HeroeMarvel,
        ex:Humano,
        ex:HumanoMutado,
        ex:Personaje,
        ex:Superheroe,
        rdfs:Resource ;
    ex:poseeArtefacto ex:EscudoVibranium ;
    ex:tienePoder ex:FuerzaMejorada ;
    ex:usaIdentidadOculta false ;
    ex:valorAmenaza 4 ;
    ex:valorPoder 48 ;
    ex:valorPopularidad 97 ;
    foaf:name "Steve Rogers"^^xsd:string .

ex:Carnage a ex:Humano,
