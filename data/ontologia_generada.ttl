ex:esArchienemigoDe a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Es Archienemigo De" ;
    dcterms:description "Subpropiedad para archirrivalidad histórica." ;
    rdfs:subPropertyOf ex:esArchienemigoDe,
        ex:esEnemigoDe .

ex:poseeArmaMitica a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Posee Arma Mítica" ;
    dcterms:description "Subpropiedad para armas divinas/míticas." ;
    rdfs:subPropertyOf ex:poseeArmaMitica,
        ex:poseeArtefacto .

ex:tieneCapa a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Tiene Capa" ;
    dcterms:description "Indica si el personaje viste capa en su traje." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ex:tieneCapa .

ex:tienePoder a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Tiene Poder" ;
    dcterms:description "Relaciona un personaje con su habilidad innata." ;
    rdfs:domain ex:Personaje ;
    rdfs:range ex:Superpoder ;
    rdfs:subPropertyOf ex:tienePoder .

ex:usaIdentidadOculta a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Usa Identidad Oculta" ;
    dcterms:description "Indica si oculta su cara/identidad." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ex:usaIdentidadOculta .

ex:valorAmenaza a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Valor Amenaza" ;
    dcterms:description "Métrica de 0 a 10 para lógica difusa." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ex:valorAmenaza .

ex:valorPoder a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Valor Poder" ;
    dcterms:description "Métrica de 0 a 100 para lógica difusa." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ex:valorPoder .

ex:valorPopularidad a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Valor Popularidad" ;
    dcterms:description "Métrica de 0 a 100 para lógica difusa." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ex:valorPopularidad .

dcterms:description a rdf:Property ;
    rdfs:subPropertyOf dcterms:description .

rdf:type a rdf:Property ;
    rdfs:subPropertyOf rdf:type .

rdfs:domain a rdf:Property ;
    rdfs:subPropertyOf rdfs:domain .

rdfs:label a rdf:Property ;
    rdfs:subPropertyOf rdfs:label .

rdfs:range a rdf:Property ;
    rdfs:subPropertyOf rdfs:range .

rdfs:subClassOf a rdf:Property ;
    rdfs:subPropertyOf rdfs:subClassOf .

rdfs:subPropertyOf a rdf:Property ;
    rdfs:subPropertyOf rdfs:subPropertyOf .

foaf:name a rdf:Property,
        rdfs:Resource ;
    rdfs:label "Nombre Real" ;
    dcterms:description "Nombre civil o de identidad real (Vocabulario FOAF)." ;
    rdfs:domain ex:Personaje ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:name .

